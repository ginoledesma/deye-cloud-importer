# Get these from https://developer.deyecloud.com (create an application).
DEYE_APP_ID=
DEYE_APP_SECRET=

# Your deyecloud.com login. Use one of EMAIL / USERNAME / MOBILE (+ COUNTRY_CODE).
DEYE_EMAIL=
# DEYE_USERNAME=
# DEYE_MOBILE=
# DEYE_COUNTRY_CODE=

# Plain password (hashed with SHA-256 before sending), or the hash itself.
DEYE_PASSWORD=
# DEYE_PASSWORD_SHA256=

# Pick the data center your account lives in:
#   EU: https://eu1-developer.deyecloud.com   US: https://us1-developer.deyecloud.com
DEYE_BASE_URL=https://eu1-developer.deyecloud.com

# Optional: skip the lookup if you have more than one station (see `python deye_export.py stations`).
# DEYE_STATION_ID=
